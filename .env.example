# Required. OAuth "Desktop app" client from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Enables the "Ask Claude what to do" button. https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Optional. Port for the local server (default 8000).
PORT=8000
