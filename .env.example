# Google OAuth 2.0 Web client — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# 32 url-safe base64 bytes. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_SECRET=

# Where the frontend runs (CORS + post-login redirect)
FRONTEND_ORIGIN=http://localhost:5173

# Set to true behind HTTPS in production
COOKIE_SECURE=false
